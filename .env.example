# Copy to .env. Defaults are safe for local development.
APP_NAME=kyc-onboarding-api
LOG_LEVEL=INFO

# SQLite for local/dev/tests; docker-compose overrides with Postgres.
DATABASE_URL=sqlite:///./kyc.db
# DATABASE_URL=postgresql+psycopg://kyc:kyc@db:5432/kyc

# Document storage: "local" (default) or "s3" (requires the [s3] extra and credentials)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=kyc-documents
# S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Upload limits
MAX_UPLOAD_BYTES=5242880

# API keys: comma-separated "key:role:display name". Roles: agent, reviewer, admin.
API_KEYS=agent-dev-key:agent:Onboarding App,reviewer-dev-key:reviewer:Nadia Rahman,admin-dev-key:admin:Ops Admin

# Risk & workflow
AUTO_APPROVE_LOW_RISK=true
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
FACE_MATCH_THRESHOLD=0.80
MIN_APPLICANT_AGE=18
REVIEW_SLA_HOURS=24
SANCTIONS_CSV=
